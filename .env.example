# Copy this file to .env and replace every placeholder.
# .env is git-ignored. Never commit real values.

# --- Postgres ---
POSTGRES_USER=graphlens
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=graphlens
POSTGRES_PORT=5432

# --- Neo4j (user is always "neo4j"; password must be at least 8 characters) ---
NEO4J_PASSWORD=change-me-neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Qdrant and Redis ---
QDRANT_PORT=6333
REDIS_PORT=6379

# --- API ---
API_PORT=8000

# --- LLM (ADR-0001). Not used in Phase 0. ---
OPENAI_API_KEY=sk-placeholder-not-a-real-key
LLM_MODEL_SMALL=to-be-chosen-in-phase-1
LLM_MODEL_MAIN=to-be-chosen-in-phase-1
LLM_DAILY_COST_CAP_USD=1.00
# Optional: use a local model instead of OpenAI (leave empty for OpenAI)
LLM_BASE_URL=
